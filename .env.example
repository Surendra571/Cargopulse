# Environment Configuration Template for CargoPulse
# Copy this file to .env and adjust credentials as appropriate for local development.

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
APP_NAME=CargoPulse
APP_VERSION=0.1.0

# Security & CORS
SECRET_KEY=cargopulse_dev_super_secret_key_change_in_production_minimum_32_characters_long
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cargopulse
POSTGRES_USER=cargopulse_user
POSTGRES_PASSWORD=cargopulse_dev_password
DATABASE_URL=postgresql+asyncpg://cargopulse_user:cargopulse_dev_password@localhost:5432/cargopulse
DATABASE_SYNC_URL=postgresql+psycopg2://cargopulse_user:cargopulse_dev_password@localhost:5432/cargopulse

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Background Worker (Celery)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend Development
VITE_API_BASE_URL=http://localhost:8000
