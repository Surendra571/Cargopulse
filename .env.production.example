# CargoPulse Production Environment Template
# Copy to .env.production and populate via your secrets manager (AWS Secrets Manager / GCP Secret Manager / Vault).
# NEVER commit populated .env.production files to version control.

# Application
ENVIRONMENT=production
DEBUG=false
APP_NAME=CargoPulse
APP_VERSION=0.1.0

# Security (Generate SECRET_KEY with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true

# Strict CORS Origins (comma-separated HTTPS origins only)
ALLOWED_ORIGINS=https://app.cargopulse.example.com

# Managed PostgreSQL (RDS / Cloud SQL / Supabase / Neon)
POSTGRES_SERVER=managed-postgres.internal
POSTGRES_PORT=5432
POSTGRES_DB=cargopulse_prod
POSTGRES_USER=cargopulse_app
POSTGRES_PASSWORD=CHANGE_ME_MANAGED_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://cargopulse_app:CHANGE_ME_MANAGED_POSTGRES_PASSWORD@managed-postgres.internal:5432/cargopulse_prod?ssl=require
DATABASE_SYNC_URL=postgresql+psycopg2://cargopulse_app:CHANGE_ME_MANAGED_POSTGRES_PASSWORD@managed-postgres.internal:5432/cargopulse_prod?sslmode=require

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Managed Redis (ElastiCache / Memorystore / Upstash)
REDIS_HOST=managed-redis.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_MANAGED_REDIS_PASSWORD
REDIS_URL=rediss://:CHANGE_ME_MANAGED_REDIS_PASSWORD@managed-redis.internal:6379/0
CELERY_BROKER_URL=rediss://:CHANGE_ME_MANAGED_REDIS_PASSWORD@managed-redis.internal:6379/1
CELERY_RESULT_BACKEND=rediss://:CHANGE_ME_MANAGED_REDIS_PASSWORD@managed-redis.internal:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Object Storage (S3 / MinIO / R2)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_REGION_NAME=ap-south-1
S3_BUCKET_NAME=cargopulse-prod-epod
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY

# Observability & Error Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Frontend Build Arg
VITE_API_BASE_URL=/api/v1
